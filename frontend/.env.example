# frontend/.env.example — copy to .env if you need to override defaults
# In dev, API calls proxy to http://localhost:3001 via package.json "proxy".
# In Docker, nginx proxies /api to the backend service.
#
# For a Firebase Hosting build (static, no proxy), set this to the deployed
# backend origin so the SPA calls it directly. Baked in at `npm run build` time.
# REACT_APP_API_URL=https://aquaconnect-api.onrender.com
